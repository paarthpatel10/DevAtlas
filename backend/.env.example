# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=development
APP_NAME=Open Source Intelligence Platform
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Hosted Postgres with pgvector (Neon). `neon deploy` / `neon env pull` write these to the
# repo-root .env, which the backend also reads. Plain postgresql:// URLs are rewritten to
# the psycopg driver scheme (postgresql+psycopg://) automatically.
# Pooled (-pooler host) for app traffic:
DATABASE_URL=
# Direct (no -pooler) for Alembic migrations; falls back to DATABASE_URL:
DATABASE_URL_UNPOOLED=
# Separate database/branch used ONLY by tests (it is wiped by the test suite).
TEST_DATABASE_URL=

# Optional: raises the GitHub API limit from 60 to 5,000 requests/hour.
# A token with public read-only access is enough.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# AI provider: "mock" (deterministic demo mode, no credentials) or "bedrock" (milestone M3).
AI_PROVIDER=mock
EMBEDDING_DIM=1024
RRF_K=60

# Bedrock settings (milestone M3; unused in M1)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_LLM_MODEL_ID=
# BEDROCK_EMBEDDING_MODEL_ID=

CORS_ORIGINS=["http://localhost:3000"]
MAX_REQUEST_BYTES=65536
